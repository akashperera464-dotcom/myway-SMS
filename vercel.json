{
    "installCommand":  "pnpm install --frozen-lockfile",
    "buildCommand":  "cd artifacts/myway \u0026\u0026 pnpm run build",
    "outputDirectory":  "artifacts/myway/dist/public",
    "routes":  [
                   {
                       "handle":  "filesystem"
                   },
                   {
                       "src":  "/.*",
                       "dest":  "/index.html"
                   }
               ]
}